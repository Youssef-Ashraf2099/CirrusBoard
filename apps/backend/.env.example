PORT=3001
# Loaded automatically via dotenv/config in main.ts (apps/backend/.env)
AWS_REGION=us-east-1
# LocalStack/Dynamo Local: uncomment and restart API. Signing uses dummy keys when unset:
# AWS_ACCESS_KEY_ID=local AWS_SECRET_ACCESS_KEY=local (defaults applied automatically)
# DYNAMODB_ENDPOINT=http://localhost:4566

USERS_TABLE=Users
TASKS_TABLE=Tasks
TASKS_TEAM_GSI=teamId-index
TASKS_ASSIGNEE_GSI=assigneeId-index
PROJECTS_TABLE=Projects
COMMENTS_TABLE=Comments

TEAMS_TABLE=Teams
NOTIFICATIONS_TABLE=Notifications

# Task audit + team activity feed (single table)
TASK_AUDIT_LOGS_TABLE=TaskAuditLogs
# GSI on TaskAuditLogs: PK=teamId, SK=createdAt (see docs/dynamodb-task-audit-gsi.md)
TASK_AUDIT_LOGS_TEAM_GSI=TeamActivityIndex

# S3 attachments (required for task file uploads)
S3_BUCKET_NAME=cirrusboard-upload
# S3_ENDPOINT=http://localhost:4566
# S3_FORCE_PATH_STYLE=true

# Optional: comma-separated origins when not using Next proxy
# CORS_ORIGIN=http://localhost:3000
