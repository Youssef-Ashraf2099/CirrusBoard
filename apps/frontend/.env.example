# Nest API base URL (server-side only; used by Next.js route handlers)
BACKEND_URL=http://127.0.0.1:3001

# Default team id persisted on signup (`primaryTeamId`)
NEXT_PUBLIC_DEFAULT_TEAM_ID=default-team

# Task uploads use backend S3 presigned URLs — configure bucket + CORS on AWS (see docs/task-attachments-s3.md)
